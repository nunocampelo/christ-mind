# Copy to .env and fill in. Loaded by each Python entrypoint via infrastructure.config.env
# (load_env). A real environment variable set by the shell/container/orchestrator always
# wins over this file, so production need not ship a .env. .env itself is gitignored — do
# not commit real values.

# --- a2a-server (apps/a2a-server) ---
# Base URL clients reach; the agent card advertises <AGENT_PUBLIC_URL>/a2a. Required.
# For local frontend dev, set to the Vite origin so the card stays same-origin.
AGENT_PUBLIC_URL=http://127.0.0.1:8765
# Async SQLAlchemy URL for the shared engine (task store + conversation history). Required.
DATABASE_URL=postgresql+asyncpg://christ:christ@127.0.0.1:5432/christ_mind
# Optional: uvicorn bind. Defaults 127.0.0.1 / 8765.
# HOST=127.0.0.1
# PORT=8765

# --- LLM proxy (src/infrastructure/llm/anthropic_proxy.py) ---
# Optional: override the Anthropic base URL and extraction model. Defaults live in code.
# ANTHROPIC_BASE_URL=
# ANTHROPIC_EXTRACTION_MODEL=

# --- retrieval (src/application/retrieval/hybrid.py) ---
# Optional: set to "lexical" to bypass the semantic (embeddings) channel of find_claims.
# Default is hybrid (lexical + semantic). Use "lexical" to reproduce a lexical-only
# baseline for eval A/B comparison, or as a one-line production revert.
# RETRIEVAL_MODE=hybrid
